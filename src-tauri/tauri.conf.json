{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beatalvi",
  "version": "0.10.5",
  "identifier": "anhsirk0.beatalvi",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beatalvi",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.svg"
    ]
  }
}
